{
  "color": {
    "raw": {
      "gray-1000": "#0B0C0F",
      "gray-900": "#15171C",
      "gray-800": "#1F222A",
      "gray-700": "#2C3039",
      "gray-400": "#8A8F9C",
      "gray-100": "#E8EAEE",
      "white": "#FFFFFF",
      "accent-500": "#F2F2F2"
    },
    "surface": {
      "canvas": "{color.raw.gray-1000}",
      "letterbox": "#000000",
      "card": "{color.raw.gray-800}",
      "raised": "{color.raw.gray-700}"
    },
    "text": {
      "default": "{color.raw.gray-100}",
      "muted": "{color.raw.gray-400}",
      "inverse": "{color.raw.gray-1000}"
    },
    "focus": {
      "ring": "{color.raw.white}"
    },
    "brand": {
      "wordmark": "{color.raw.white}",
      "accent": "{color.raw.accent-500}"
    }
  },
  "space": {
    "xs": "8px",
    "sm": "16px",
    "md": "24px",
    "lg": "48px",
    "xl": "96px",
    "safe-x": "96px",
    "safe-y": "54px"
  },
  "radius": { "sm": "8px", "md": "12px", "lg": "20px", "pill": "999px" },
  "font": {
    "family": { "base": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
    "weight": { "regular": "400", "medium": "500", "bold": "700" },
    "size": { "sm": "22px", "md": "28px", "lg": "36px", "xl": "48px", "xxl": "72px" }
  },
  "focus": { "ring-width": "4px", "scale": "1.06" },
  "dim": { "opacity": "0.5" },
  "motion": {
    "duration": { "fast": "160ms", "base": "280ms", "slow": "480ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" }
  }
}
