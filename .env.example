# Copy to .env.local (gitignored) and fill in. Never commit real values.
# TMDB API Read Access Token (v4 auth), used only by `npm run sync`.
TMDB_READ_TOKEN=
# Cloudflare R2 upload key (Account API token "spark-tv-upload", Object Read & Write on spark-tv-media only),
# used only by `npm run media:upload`. The account ID is the subdomain of the bucket's S3 API URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: where the downloaded Blender masters live (default ~/Downloads/spark-tv-films).
# SPARKFREE_SOURCE_DIR=
